# ─────────────────────────────────────────────────────────────────────────
# Money Market Intelligence — 환경 변수 템플릿
#
#   cp .env.example .env      # 이 파일을 복사한 뒤 아래 키를 채우세요
#   uv run python -m app.doctor   # 키가 실제로 동작하는지 점검합니다
#
# 이 파일(.env.example)은 커밋되지만 .env 는 .gitignore로 제외됩니다.
# 실제 키는 .env 또는 OS keychain에만 두고 코드·문서·로그에 남기지 마세요.
#
# 전체 절차와 발급 화면 안내: docs/sources/setup.md
# ─────────────────────────────────────────────────────────────────────────

# ══ 필수 ═══════════════════════════════════════════════════════════════
# 이 두 개가 없으면 지표 164개 중 140개가 수집되지 않습니다.

# 한국은행 ECOS — 한국 금리·환율·물가·통화·성장 계열 89개
#   발급: https://ecos.bok.or.kr/  →  [오픈API] → 인증키 신청
#   소요: 즉시 발급 (이메일 인증만)
#   형식: 영문+숫자 조합
ECOS_API_KEY=

# FRED (세인트루이스 연은) — 미국·주요국 거시계열 59개
#   발급: https://fredaccount.stlouisfed.org/apikeys
#   소요: 즉시 발급 (계정 생성 후 바로)
#   형식: 32자 소문자+숫자
FRED_API_KEY=

# ══ 선택 ═══════════════════════════════════════════════════════════════

# KRX Open API — 국내 시장폭(등락종목수·거래대금·쏠림)에만 사용
#   없어도 나머지 기능은 전부 동작합니다. 국내 지수·ETF 시세는 Yahoo로 들어옵니다.
#   발급: https://openapi.krx.co.kr/  →  인증키 신청
#   ★ 키 발급과 별개로 "서비스별 이용 신청"을 각각 해야 합니다.
#     최소 신청 대상 2개:
#       - 유가증권 일별매매정보 (sto/stk_bydd_trd)  → KOSPI 시장폭
#       - 코스닥   일별매매정보 (sto/ksq_bydd_trd)  → KOSDAQ 시장폭
#     ※ "KOSPI 시리즈 지수(idx)"와 "유가증권 일별매매정보(sto)"는 다른 서비스입니다.
#   승인 후: uv run python -m app.collect --history-reset --history-kind krx_access
KRX_API_KEY=

# ══ 동작 설정 (기본값으로 충분합니다) ═══════════════════════════════════
# 아래는 전부 주석 처리된 기본값입니다. 필요할 때만 해제하세요.

# 백업 보존 정책
#   백업은 gzip으로 약 7.5배 압축됩니다 (150MB DB → 20MB).
#   계층 보존: 최근 N개 + 주당 1개 + 월당 1개. 각 계층은 해당 기간의
#   가장 최근 사본을 차지합니다.
#   BACKUP_MAX_TOTAL_MB 는 마지막 안전장치로, 계층과 무관하게 오래된 것부터
#   지웁니다. 다만 가장 최근 백업은 예산을 넘겨도 절대 지우지 않습니다.
#   KRX all 범위에서 DB가 연 5~6GB로 자라므로 기본값은 20GB입니다.
# BACKUP_KEEP_RECENT=3
# BACKUP_KEEP_WEEKLY=4
# BACKUP_KEEP_MONTHLY=6
# BACKUP_MAX_TOTAL_MB=20480
# BACKUP_COMPRESS=1

# 저장 위치와 스케줄러
# MONEY_DB_PATH=/absolute/path/to/money.db
# MONEY_DISABLE_SCHEDULER=1        # 수집 없이 화면만 볼 때

# 수집 주기(초) — 공급자 부담을 고려한 값입니다
# QUOTE_INTERVAL=300               # 관심 종목 시세 5분
# INDEX_QUOTE_INTERVAL=900         # 지수 현재가 15분
# INDEX_HISTORY_INTERVAL=21600     # 지수 일별 이력 6시간
# IND_DAILY_INTERVAL=21600         # 일·주간 지표 6시간
# IND_MONTHLY_INTERVAL=86400       # 월간 지표 24시간
# IND_QUARTERLY_INTERVAL=86400     # 분기·연간 지표 24시간
# EVENT_INTERVAL=21600             # 경제 일정 6시간

# 1차 결측 보상: 로컬 감사 5분, 정상 결측 1시간, 오류 6시간 백오프
# RECONCILE_INTERVAL=300
# REPAIR_BACKOFF=3600
# REPAIR_ERROR_BACKOFF=21600

# 2차 과거 완전성: 고정 manifest, 유한 시도, 실행당 자원 상한
# HISTORY_RECOVERY_INTERVAL=21600
# HISTORY_RECOVERY_MAX_ATTEMPTS=3
# HISTORY_RECOVERY_BACKOFF=21600
# HISTORY_RECOVERY_MAX_BACKOFF=604800
# HISTORY_EMPTY_CONFIRMATIONS=2
# HISTORY_INDICATOR_CALLS_PER_RUN=6
# HISTORY_INDEX_CALLS_PER_RUN=3
# HISTORY_KRX_CALLS_PER_RUN=3
# HISTORY_INDEX_YEARS=20
# HISTORY_KRX_BUSINESS_DAYS=20
# HISTORY_KRX_MAX_ROWS_PER_RUN=50000

# KRX 수집 범위와 자원 상한
#   light:    지수 + ETF + 일반상품            하루 약  1,300행
#   balanced: + 전 주식·ETN·채권/파생지수·옵션   하루 약 22,000행
#   all:      + ELW·선물·주식옵션·채권시장·ESG   하루 약 48,000행 (연 5~6GB)
#   all 은 31개 서비스 전부 이용 승인을 받아야 동작합니다.
# KRX_MARKET_ENABLED=auto
# KRX_MARKET_SCOPE=balanced
#
# all 범위에서는 2차 과거 복구 대상이 620 타깃(31 데이터셋 × 20거래일)이 되어
# 기본 예산 3건/실행으로는 소급에 약 52일이 걸립니다. 호출당 0.76초이므로
# 30건으로 올려도 1회 23초입니다.
# HISTORY_KRX_CALLS_PER_RUN=3
# KRX_MARKET_INTERVAL=86400
# KRX_CATCHUP_BUSINESS_DAYS=5
# KRX_MAX_ROWS_PER_DATASET=20000
# KRX_MAX_ROWS_PER_RUN=100000
